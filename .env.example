# =============================================================================
# Git Collaborator Access Manager - Environment Configuration
# =============================================================================

# PostgreSQL Database Configuration
POSTGRES_DB=git_collabration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5433

# Admin Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
SESSION_SECRET=replace-with-a-long-random-string

# GitHub Integration
# Personal Access Token with repo / admin:org permissions
GITHUB_PAT=github_pat_your_token_here
# GitHub User or Organization name to manage
GITHUB_OWNER=your-github-username

# Backend Service (Spring Boot)
SPRING_BOOT_PORT=8080

# Frontend Service (Next.js)
# Set to 3000 for standard compose, or 80 if exposing directly on a server without Nginx
FRONTEND_PORT=3000

# Production Reverse Proxy (When using docker-compose.prod.yml)
HTTP_PORT=80
